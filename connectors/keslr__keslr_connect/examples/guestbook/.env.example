# Copy to .env and fill in. Never commit .env.

# --- Sign in with Keslr (required) ---
# From https://developers.keslr.com
KESLR_CLIENT_ID=
# Only for confidential (web) clients. Omit for spa/mobile.
KESLR_CLIENT_SECRET=

# Must exactly match a redirect URI registered for the client above,
# with /auth/keslr/callback appended.
PUBLIC_URL=http://localhost:8080

KESLR_ISSUER=https://api.keslr.com

# openssl rand -base64 48
SESSION_SECRET=

# --- Network identity (optional) ---
# Separate credentials from the OIDC client above. Without these the example
# still runs; it just can't attribute requests to the calling member.
KESLR_API_BASE=https://api.keslr.com
KESLR_NETWORK_CLIENT_ID=
KESLR_NETWORK_CLIENT_SECRET=

# --- Advanced ---
PORT=8080
# Override the bind address. Leave unset to bind the Keslr network address,
# which is what you want in production. Never set this to 0.0.0.0 for a
# members-only service.
# BIND_ADDRESS=127.0.0.1
